"use client";

import { useInventory } from "@/lib/useInventory";
import { useHistory } from "@/lib/useHistory";
import { Card } from "./ui";
import GroceryHistory from "./GroceryHistory";
import { Button } from "./ui";

function formatQuantity(quantity: string, unit: string) {
  return `${quantity} ${unit}`.trim();
}

function InventoryOverview() {
  const { items, loading, error, refresh } = useInventory();

  return (
    <section className="mt-8" aria-labelledby="inventory-overview-title">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2
            id="inventory-overview-title"
            className="font-display text-2xl font-bold"
          >
            Your saved inventory
          </h2>
          <p className="mt-1 text-sm text-ink-soft">
            Quantities saved to your account.
          </p>
        </div>

        <Button
          type="button"
          variant="ghost"
          onClick={() => void refresh()}
          disabled={loading}
        >
          {loading ? "Loading..." : "Refresh inventory"}
        </Button>
      </div>

      {loading && (
        <Card className="mt-4 p-5 text-sm text-ink-soft">
          Loading your saved inventory...
        </Card>
      )}

      {!loading && error && (
        <Card className="mt-4 p-5">
          <p className="font-semibold text-alert">
            Unable to load your inventory.
          </p>
          <p className="mt-2 break-words text-sm text-ink-soft">{error}</p>
          <Button
            type="button"
            className="mt-3"
            variant="ghost"
            onClick={() => void refresh()}
          >
            Try again
          </Button>
        </Card>
      )}

      {!loading && !error && items.length === 0 && (
        <Card className="mt-4 p-5">
          <h3 className="font-display text-lg font-bold">
            Your inventory is empty
          </h3>
          <p className="mt-2 text-sm text-ink-soft">
            No saved items were returned for your account. Add your actual
            household items below to get started.
          </p>
        </Card>
      )}

      {!loading && !error && items.length > 0 && (
        <>
          <p className="mt-3 text-sm text-ink-soft">
            {items.length} saved {items.length === 1 ? "item" : "items"}
          </p>

          <div className="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((item) => (
              <Card className="p-4" key={item.id}>
                <h3 className="break-words font-display text-lg font-bold">
                  {item.name}
                </h3>

                {item.category && (
                  <p className="mt-1 text-sm text-ink-soft">
                    {item.category}
                  </p>
                )}

                <dl className="mt-3 space-y-2 text-sm">
                  <div className="flex justify-between gap-3">
                    <dt className="text-ink-soft">Quantity</dt>
                    <dd className="text-right font-semibold">
                      {formatQuantity(item.quantity, item.unit)}
                    </dd>
                  </div>

                  <div className="flex justify-between gap-3">
                    <dt className="text-ink-soft">Low-stock threshold</dt>
                    <dd className="text-right font-semibold">
                      {formatQuantity(item.lowStockThreshold, item.unit)}
                    </dd>
                  </div>

                  {item.expiryDate && (
                    <div className="flex justify-between gap-3">
                      <dt className="text-ink-soft">Expiry date</dt>
                      <dd className="text-right font-semibold">
                        {new Date(item.expiryDate).toLocaleDateString()}
                      </dd>
                    </div>
                  )}
                </dl>

                {item.notes && (
                  <p className="mt-3 break-words text-sm text-ink-soft">
                    {item.notes}
                  </p>
                )}
              </Card>
            ))}
          </div>
        </>
      )}
    </section>
  );
}

function RealHistorySummary() {
  const { events, loading, error, refresh } = useHistory();

  const purchases = events.filter(
    (event) => event.eventType === "purchased",
  );

  const consumptions = events.filter(
    (event) => event.eventType === "consumed",
  );

  return (
    <section className="mt-8" aria-labelledby="history-summary-title">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2
            id="history-summary-title"
            className="font-display text-2xl font-bold"
          >
            Your grocery activity
          </h2>
          <p className="mt-1 text-sm text-ink-soft">
            Counts are calculated from the grocery events returned by your
            account's history API.
          </p>
        </div>

        <Button
          type="button"
          variant="ghost"
          onClick={() => void refresh()}
          disabled={loading}
        >
          {loading ? "Loading..." : "Refresh activity"}
        </Button>
      </div>

      {loading && (
        <Card className="mt-4 p-5 text-sm text-ink-soft">
          Loading your grocery activity...
        </Card>
      )}

      {!loading && error && (
        <Card className="mt-4 p-5">
          <p className="font-semibold text-alert">
            Unable to load grocery activity.
          </p>
          <p className="mt-2 break-words text-sm text-ink-soft">{error}</p>
        </Card>
      )}

      {!loading && !error && events.length === 0 && (
        <Card className="mt-4 p-5">
          <h3 className="font-display text-lg font-bold">
            No grocery history available yet
          </h3>
          <p className="mt-2 text-sm text-ink-soft">
            There are no saved grocery events to analyze. Predictions will
            remain unavailable until sufficient real history is available.
          </p>
        </Card>
      )}

      {!loading && !error && events.length > 0 && (
        <>
          <div className="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <Card className="p-4">
              <p className="text-sm text-ink-soft">Recorded events</p>
              <p className="mt-2 font-display text-3xl font-bold">
                {events.length}
              </p>
            </Card>

            <Card className="p-4">
              <p className="text-sm text-ink-soft">Purchase events</p>
              <p className="mt-2 font-display text-3xl font-bold">
                {purchases.length}
              </p>
            </Card>

            <Card className="p-4">
              <p className="text-sm text-ink-soft">Consumption events</p>
              <p className="mt-2 font-display text-3xl font-bold">
                {consumptions.length}
              </p>
            </Card>
          </div>

          <Card className="mt-4 p-5">
            <h3 className="font-display text-lg font-bold">
              Recent recorded events
            </h3>

            <ol className="mt-3 divide-y divide-line">
              {events.slice(0, 10).map((event) => (
                <li
                  key={event.id}
                  className="flex flex-wrap items-start justify-between gap-3 py-3"
                >
                  <div>
                    <p className="font-semibold">{event.itemName}</p>
                    <p className="mt-1 text-xs text-ink-soft">
                      {new Date(event.eventDate).toLocaleString()}
                    </p>
                  </div>

                  <div className="text-right">
                    <p className="text-sm font-semibold">
                      {event.eventType === "purchased"
                        ? "Purchased"
                        : "Consumed"}
                    </p>
                    <p className="mt-1 text-sm text-ink-soft">
                      {formatQuantity(event.quantity, event.unit)}
                    </p>
                  </div>
                </li>
              ))}
            </ol>

            {events.length > 10 && (
              <p className="mt-2 text-xs text-ink-soft">
                Showing 10 of {events.length} returned events.
              </p>
            )}
          </Card>
        </>
      )}
    </section>
  );
}

export default function Dashboard({ onView }: { onView: () => void }) {
  return (
    <div className="animate-rise">
      <header className="mt-8">
        <h1 className="font-display text-4xl font-bold tracking-tight sm:text-5xl">
          Your household dashboard
        </h1>
        <p className="mt-2 text-lg text-ink-soft">
          Your saved data, without sample inventory or fabricated predictions.
        </p>
      </header>

      <InventoryOverview />

      <RealHistorySummary />

      <GroceryHistory />

      <section className="mt-8">
        <Card className="p-5">
          <h2 className="font-display text-xl font-bold">
            Restock recommendations
          </h2>
          <p className="mt-2 text-sm text-ink-soft">
            Recommendations will be shown when real inventory, purchase
            history, and supported live product data are available. No
            estimated stockout dates or prices are being invented.
          </p>
          <Button className="mt-4" onClick={onView}>
            Open shopping view
          </Button>
        </Card>
      </section>
    </div>
  );
}

