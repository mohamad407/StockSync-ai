        <DemoBadge />
      </div>

      <p className="mt-2 text-ink-soft">
        Review your selected Instamart products and estimated prices.
      </p>

      <Card className="mt-6 divide-y divide-line">
        {cart.lines.map((line) => (
          <div
            key={line.product.id}
            className="flex items-center gap-3 p-4 sm:gap-4"
